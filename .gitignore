guest/agent/gmak8-agent
guest/mkosi/mkosi.extra/usr/local/bin/gmak8-agent

# mkosi build artifacts — never vendor guest disk images
guest/mkosi/mkosi.output/
guest/mkosi/mkosi.cache/
guest/mkosi/mkosi.builddir/
guest/mkosi/mkosi.workspace/
guest/mkosi/mkosi.local.conf
