[Unit]
Description=Apply host-generated k3s config from virtiofs when present
DefaultDependencies=no
After=mnt-config.mount
Before=k3s.service
ConditionPathExists=/mnt/config/k3s/config.yaml

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/bin/sh -c 'mkdir -p /etc/rancher/k3s && cat /mnt/config/k3s/config.yaml > /etc/rancher/k3s/config.yaml; if [ -f /mnt/config/registries.yaml ]; then cat /mnt/config/registries.yaml > /etc/rancher/k3s/registries.yaml; fi'

[Install]
WantedBy=k3s.service
