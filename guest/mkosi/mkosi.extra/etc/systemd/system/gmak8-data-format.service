[Unit]
Description=Format gmak8 data NVMe if not labeled GMAK8_DATA
DefaultDependencies=no
After=local-fs-pre.target systemd-udevd.service
Wants=systemd-udevd.service
Before=mnt-data.mount umount.target
Conflicts=umount.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=10min
ExecStart=/usr/local/lib/gmak8/format-data-disk.sh
