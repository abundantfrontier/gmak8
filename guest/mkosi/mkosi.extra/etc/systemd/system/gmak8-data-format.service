[Unit]
Description=Format gmak8 data NVMe if not labeled GMAK8_DATA
DefaultDependencies=no
After=local-fs-pre.target dev-nvme1n1.device
Wants=dev-nvme1n1.device
Before=mnt-data.mount umount.target
Conflicts=umount.target
ConditionPathExists=/dev/nvme1n1

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=10min
ExecStart=/usr/local/lib/gmak8/format-data-disk.sh
